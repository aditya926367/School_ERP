generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["school_erp"]
}

/// Multi-school tenant root table (har school ka alag isolated data)
model schools {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_code                   String                          @unique @db.VarChar(50)
  name                          String                          @db.VarChar(200)
  email                         String?                         @db.VarChar(254)
  phone                         String?                         @db.VarChar(30)
  address                       String?
  logo_file_id                  String?                         @db.Uuid
  status                        String                          @default("active") @db.VarChar(20)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  logo_file                     file_assets?                    @relation("school_logo_file", fields: [logo_file_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  academic_years                academic_years[]
  admissions                    admissions[]
  admission_documents           admission_documents[]
  announcements                 announcements[]
  campuses                      campuses[]
  certificate_templates         certificate_templates[]
  class_subjects                class_subjects[]
  classes                       classes[]
  exam_results                  exam_results[]
  exam_subjects                 exam_subjects[]
  exams                         exams[]
  expenses                      expenses[]
  fee_discounts                 fee_discounts[]
  fee_heads                     fee_heads[]
  fee_payments                  fee_payments[]
  fee_structure_items           fee_structure_items[]
  fee_structures                fee_structures[]
  file_categories               file_categories[]
  file_assets                   file_assets[]
  guardian_documents            guardian_documents[]
  holidays                      holidays[]
  homework                      homework[]
  homework_documents            homework_documents[]
  homework_submission_documents homework_submission_documents[]
  homework_submissions          homework_submissions[]
  invoice_items                 invoice_items[]
  issued_certificates           issued_certificates[]
  library_authors               library_authors[]
  library_book_authors          library_book_authors[]
  library_book_copies           library_book_copies[]
  library_book_fines            library_book_fines[]
  library_book_issues           library_book_issues[]
  library_books                 library_books[]
  library_categories            library_categories[]
  library_members               library_members[]
  library_publishers            library_publishers[]
  messages                      messages[]
  notices                       notices[]
  parents_guardians             parents_guardians[]
  password_reset_tokens         password_reset_tokens[]
  payment_allocations          payment_allocations[]
  payroll_items                 payroll_items[]
  payroll_runs                  payroll_runs[]
  role_permissions              role_permissions[]
  roles                         roles[]
  salary_payments               salary_payments[]
  sections                      sections[]
  staff                         staff[]
  staff_attendance              staff_attendance[]
  student_attendance            student_attendance[]
  student_documents             student_documents[]
  student_enrollments           student_enrollments[]
  student_guardians             student_guardians[]
  student_invoices              student_invoices[]
  students                      students[]
  subjects                      subjects[]
  timetable_entries             timetable_entries[]
  user_roles                    user_roles[]
  users                         users[]

  @@schema("school_erp")
}

/// Login users (admin, accountant, teacher, parent, student) per school
model users {
  id                                                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id                                                String                  @db.Uuid
  campus_id                                                String?                 @db.Uuid
  email                                                    String                  @db.VarChar(254)
  phone                                                    String?                 @db.VarChar(30)
  password_hash                                            String
  full_name                                                String                  @db.VarChar(180)
  avatar_file_id                                           String?                 @db.Uuid
  status                                                   String                  @default("active") @db.VarChar(20)
  created_at                                               DateTime                @default(now()) @db.Timestamptz(6)
  schools                                                  schools                 @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campuses                                                 campuses?               @relation(fields: [school_id, campus_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  avatar_file                                              file_assets?            @relation("user_avatar_file", fields: [school_id, avatar_file_id], references: [school_id, id], onDelete: SetNull, onUpdate: NoAction)
  uploaded_files                                           file_assets[]           @relation("file_uploader")
  announcements                                            announcements[]
  notices                                                  notices[]
  sent_messages                                            messages[]              @relation("message_sender")
  received_messages                                        messages[]              @relation("message_receiver")
  issued_certificates                                      issued_certificates[]
  expenses                                                 expenses[]
  fee_discounts                                            fee_discounts[]
  fee_payments                                             fee_payments[]
  parents_guardians                                        parents_guardians[]
  password_reset_tokens                                    password_reset_tokens[]
  payroll_runs_payroll_runs_school_id_approved_by_user_id  payroll_runs[]          @relation("payroll_runs_school_id_approved_by_user_idTousers")
  payroll_runs_payroll_runs_school_id_generated_by_user_id payroll_runs[]          @relation("payroll_runs_school_id_generated_by_user_idTousers")
  salary_payments                                          salary_payments[]
  user_roles                                               user_roles[]

  @@unique([school_id, email])
  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Students master table per school
model students {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id            String                 @db.Uuid
  campus_id            String?                @db.Uuid
  admission_no         String                 @db.VarChar(60)
  first_name           String                 @db.VarChar(100)
  last_name            String?                @db.VarChar(100)
  date_of_birth        DateTime?              @db.Date
  gender               String?                @db.VarChar(20)
  photo_file_id        String?                @db.Uuid
  status               String                 @default("active") @db.VarChar(20)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  schools              schools                @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campuses             campuses?              @relation(fields: [school_id, campus_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  photo_file           file_assets?           @relation("student_photo_file", fields: [school_id, photo_file_id], references: [school_id, id], onDelete: SetNull, onUpdate: NoAction)
  admissions           admissions[]
  exam_results         exam_results[]
  fee_discounts        fee_discounts[]
  fee_payments         fee_payments[]
  homework_submissions homework_submissions[]
  issued_certificates  issued_certificates[]
  library_members      library_members[]
  student_attendance   student_attendance[]
  student_documents    student_documents[]
  student_enrollments  student_enrollments[]
  student_guardians    student_guardians[]
  student_invoices     student_invoices[]

  @@unique([school_id, admission_no])
  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Staff / Teachers master table per school
model staff {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String             @db.Uuid
  campus_id        String?            @db.Uuid
  staff_code       String             @db.VarChar(60)
  first_name       String             @db.VarChar(100)
  last_name        String?            @db.VarChar(100)
  designation      String?            @db.VarChar(100)
  photo_file_id    String?            @db.Uuid
  status           String             @default("active") @db.VarChar(20)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  schools          schools            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campuses         campuses?          @relation(fields: [school_id, campus_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  photo_file       file_assets?       @relation("staff_photo_file", fields: [school_id, photo_file_id], references: [school_id, id], onDelete: SetNull, onUpdate: NoAction)
  class_subjects   class_subjects[]
  exam_results     exam_results[]
  homework         homework[]
  library_members  library_members[]
  payroll_items    payroll_items[]
  staff_attendance staff_attendance[]

  @@unique([school_id, id])
  @@unique([school_id, staff_code])
  @@schema("school_erp")
}

/// Documents aur images ki category (jaise student_doc, camera_photo, homework_file)
model file_categories {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id   String        @db.Uuid
  code        String        @db.VarChar(60)
  name        String        @db.VarChar(120)
  description String?
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  schools     schools       @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file_assets file_assets[]

  @@unique([school_id, code])
  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Uploaded documents aur captured/uploaded images ka central storage table
model file_assets {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id                     String                          @db.Uuid
  category_id                   String?                         @db.Uuid
  uploaded_by_user_id           String?                         @db.Uuid
  file_name                     String                          @db.VarChar(255)
  mime_type                     String                          @db.VarChar(120)
  file_size                     Int
  file_data                     Bytes
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  schools                       schools                         @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file_categories               file_categories?                @relation(fields: [school_id, category_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  uploaded_by                   users?                          @relation("file_uploader", fields: [school_id, uploaded_by_user_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  school_logos                  schools[]                       @relation("school_logo_file")
  user_avatars                  users[]                         @relation("user_avatar_file")
  student_photos                students[]                      @relation("student_photo_file")
  staff_photos                  staff[]                         @relation("staff_photo_file")
  student_documents             student_documents[]
  admission_documents           admission_documents[]
  homework_documents            homework_documents[]
  homework_submission_documents homework_submission_documents[]
  guardian_documents            guardian_documents[]
  certificate_templates         certificate_templates[]

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Student ke documents (certificates, ID proofs, transfer records, etc.)
model student_documents {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id     String      @db.Uuid
  student_id    String      @db.Uuid
  file_asset_id String      @db.Uuid
  doc_type      String?     @db.VarChar(80)
  title         String?     @db.VarChar(180)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  schools       schools     @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students      students    @relation(fields: [school_id, student_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)
  file_assets   file_assets @relation(fields: [school_id, file_asset_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Admission ke waqt upload hone wale documents/images
model admission_documents {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id     String      @db.Uuid
  admission_id  String      @db.Uuid
  file_asset_id String      @db.Uuid
  doc_type      String?     @db.VarChar(80)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  schools       schools     @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admissions    admissions  @relation(fields: [school_id, admission_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)
  file_assets   file_assets @relation(fields: [school_id, file_asset_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Teacher ke homework ki attachments/files
model homework_documents {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id     String      @db.Uuid
  homework_id   String      @db.Uuid
  file_asset_id String      @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  schools       schools     @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  homework      homework    @relation(fields: [school_id, homework_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)
  file_assets   file_assets @relation(fields: [school_id, file_asset_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Student homework submission ke uploaded files/photos
model homework_submission_documents {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id              String               @db.Uuid
  homework_submission_id String               @db.Uuid
  file_asset_id          String               @db.Uuid
  created_at             DateTime             @default(now()) @db.Timestamptz(6)
  schools                schools              @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  homework_submissions   homework_submissions @relation(fields: [school_id, homework_submission_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)
  file_assets            file_assets          @relation(fields: [school_id, file_asset_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Parent / Guardian ke documents
model guardian_documents {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id         String            @db.Uuid
  guardian_id       String            @db.Uuid
  file_asset_id     String            @db.Uuid
  doc_type          String?           @db.VarChar(80)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  schools           schools           @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parents_guardians parents_guardians @relation(fields: [school_id, guardian_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)
  file_assets       file_assets       @relation(fields: [school_id, file_asset_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}




/// Certificate templates (TC, character, bonafide, award) per school
model certificate_templates {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id           String                @db.Uuid
  code                String                @db.VarChar(60)
  title               String                @db.VarChar(160)
  certificate_type    String                @db.VarChar(40)
  body_template       String
  background_file_id  String?               @db.Uuid
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  schools             schools               @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  background_file     file_assets?          @relation(fields: [school_id, background_file_id], references: [school_id, id], onDelete: SetNull, onUpdate: NoAction)
  issued_certificates issued_certificates[]

  @@unique([school_id, code])
  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Students ko issue hue certificates ka record
model issued_certificates {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id            String                @db.Uuid
  template_id          String                @db.Uuid
  student_id           String                @db.Uuid
  certificate_no       String                @db.VarChar(80)
  issue_date           DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  is_locked            Boolean               @default(false)
  remarks              String?
  issued_by_user_id    String?               @db.Uuid
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  schools              schools               @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  certificate_template certificate_templates @relation(fields: [school_id, template_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  students             students              @relation(fields: [school_id, student_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)
  issued_by            users?                @relation(fields: [school_id, issued_by_user_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([school_id, certificate_no])
  @@unique([school_id, id])
  @@schema("school_erp")
}

/// School-wide ya role-specific announcements
model announcements {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id       String    @db.Uuid
  title           String    @db.VarChar(200)
  content         String
  target_audience String    @default("all") @db.VarChar(40)
  published_at    DateTime  @default(now()) @db.Timestamptz(6)
  expires_at      DateTime? @db.Timestamptz(6)
  created_by_user String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  schools         schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by      users?    @relation(fields: [school_id, created_by_user], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Official school notices
model notices {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id       String    @db.Uuid
  title           String    @db.VarChar(200)
  body            String
  target_audience String    @default("all") @db.VarChar(40)
  notice_date     DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_by_user String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  schools         schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by      users?    @relation(fields: [school_id, created_by_user], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Direct / group messages between users (teacher, parent, student, admin)
model messages {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String    @db.Uuid
  sender_user_id   String    @db.Uuid
  receiver_user_id String?   @db.Uuid
  subject          String?   @db.VarChar(200)
  body             String
  is_read          Boolean   @default(false)
  sent_at          DateTime  @default(now()) @db.Timestamptz(6)
  schools          schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender           users     @relation("message_sender", fields: [school_id, sender_user_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)
  receiver         users?    @relation("message_receiver", fields: [school_id, receiver_user_id], references: [school_id, id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// School holidays calendar
model holidays {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id    String   @db.Uuid
  title        String   @db.VarChar(160)
  holiday_date DateTime @db.Date
  holiday_type String   @default("public") @db.VarChar(40)
  description  String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  schools      schools  @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, id])
  @@unique([school_id, holiday_date, title])
  @@schema("school_erp")
}

/// Staff / Teachers daily attendance
model staff_attendance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id       String   @db.Uuid
  staff_id        String   @db.Uuid
  attendance_date DateTime @db.Date
  status          String   @db.VarChar(20)
  remarks         String?
  schools         schools  @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff           staff    @relation(fields: [school_id, staff_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, staff_id, attendance_date])
  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Library book issue & return tracking
model library_book_issues {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id          String               @db.Uuid
  copy_id            String               @db.Uuid
  member_id          String               @db.Uuid
  issued_on          DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date           DateTime             @db.Date
  returned_on        DateTime?            @db.Date
  status             String               @default("issued") @db.VarChar(20)
  schools            schools              @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  copy               library_book_copies  @relation(fields: [school_id, copy_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  member             library_members      @relation(fields: [school_id, member_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  library_book_fines library_book_fines[]

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Library late return / damage fines
model library_book_fines {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id   String              @db.Uuid
  issue_id    String              @db.Uuid
  amount      Decimal             @db.Decimal(10, 2)
  paid_amount Decimal             @default(0) @db.Decimal(10, 2)
  status      String              @default("unpaid") @db.VarChar(20)
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  schools     schools             @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issue       library_book_issues @relation(fields: [school_id, issue_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

model academic_years {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id           String                @unique(map: "one_current_academic_year_per_school", where: raw("is_current")) @db.Uuid
  name                String                @db.VarChar(40)
  start_date          DateTime              @db.Date
  end_date            DateTime              @db.Date
  is_current          Boolean               @default(false)
  status              String                @default("planned") @db.VarChar(20)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  schools             schools               @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admissions          admissions[]
  class_subjects      class_subjects[]
  exams               exams[]
  fee_structures      fee_structures[]
  homework            homework[]
  student_attendance  student_attendance[]
  student_enrollments student_enrollments[]
  student_invoices    student_invoices[]
  timetable_entries   timetable_entries[]

  @@unique([school_id, id])
  @@unique([school_id, name])
  @@schema("school_erp")
}

model admissions {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id           String                @db.Uuid
  application_no      String                @db.VarChar(60)
  academic_year_id    String?               @db.Uuid
  applicant_name      String                @db.VarChar(200)
  date_of_birth       DateTime?             @db.Date
  applying_for_class  String?               @db.VarChar(80)
  parent_name         String?               @db.VarChar(180)
  parent_phone        String?               @db.VarChar(30)
  parent_email        String?               @db.VarChar(254)
  application_date    DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  status              String                @default("submitted") @db.VarChar(30)
  remarks             String?
  student_id          String?               @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
