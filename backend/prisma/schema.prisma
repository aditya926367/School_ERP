  school_id          String    @db.Uuid
  order_code         String?   @db.VarChar(60)
  title              String    @db.VarChar(220)
  author_name        String?   @db.VarChar(180)
  supplier_name      String    @db.VarChar(180)
  quantity           Int       @default(1)
  unit_price         Decimal   @default(0) @db.Decimal(10, 2)
  order_date         DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  received_date      DateTime? @db.Date
  status             String    @default("Ordered") @db.VarChar(30)
  created_by_user_id String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  schools            schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by         users?    @relation("library_order_creator", fields: [school_id, created_by_user_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Library physical vs system stock audit records (stockVerification.tsx)
model library_stock_verifications {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id           String        @db.Uuid
  book_id             String        @db.Uuid
  system_copies       Int
  physical_count      Int?
  difference          Int           @default(0)
  status              String        @default("Not counted") @db.VarChar(30)
  remarks             String?
