/// Audit trail for user actions across modules (AuditLog.tsx)
model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id   String   @db.Uuid
  user_id     String?  @db.Uuid
  actor_name  String?  @db.VarChar(180)
  role_name   String?  @db.VarChar(80)
  action      String   @db.VarChar(30)
  module      String   @db.VarChar(100)
  description String
  ip_address  String?  @db.VarChar(64)
  status      String   @default("Success") @db.VarChar(20)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  schools     schools  @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?   @relation("audit_log_actor", fields: [school_id, user_id], references: [school_id, id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([school_id, id])
  @@index([school_id, created_at])
  @@schema("school_erp")
}

/// Book purchase / acquisition orders (orderBook.tsx)
model library_book_orders {
