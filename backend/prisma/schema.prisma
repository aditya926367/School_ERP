// School ERP: paired with baseline.sql. SQL-only checks, partial/expression indexes and triggers must be preserved.
// Use migrations, not db push, for full database behavior.
// The current-year partial unique index lives in SQL to retain the one-to-many relation.
// Financial year selection uses academic_years unless a separate fiscal calendar is required.
generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["school_erp"]
}

