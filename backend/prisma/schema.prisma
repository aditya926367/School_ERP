/// Login users (admin, accountant, teacher, parent, student) per school
model users {
  id                                                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id                                                String                  @db.Uuid
  campus_id                                                String?                 @db.Uuid
  email                                                    String                  @db.VarChar(254)
  phone                                                    String?                 @db.VarChar(30)
  password_hash                                            String
  full_name                                                String                  @db.VarChar(180)
  avatar_file_id                                           String?                 @db.Uuid
  status                                                   String                  @default("active") @db.VarChar(20)
  created_at                                               DateTime                @default(now()) @db.Timestamptz(6)
  schools                                                  schools                 @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campuses                                                 campuses?               @relation(fields: [school_id, campus_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  avatar_file                                              file_assets?            @relation("user_avatar_file", fields: [school_id, avatar_file_id], references: [school_id, id], onDelete: SetNull, onUpdate: NoAction)
  uploaded_files                                           file_assets[]           @relation("file_uploader")
  announcements                                            announcements[]
  notices                                                  notices[]
  sent_messages                                            messages[]              @relation("message_sender")
  received_messages                                        messages[]              @relation("message_receiver")
  issued_certificates                                      issued_certificates[]
  expenses                                                 expenses[]
  fee_discounts                                            fee_discounts[]
  fee_payments                                             fee_payments[]
  parents_guardians                                        parents_guardians[]
  password_reset_tokens                                    password_reset_tokens[]
  payroll_runs_payroll_runs_school_id_approved_by_user_id  payroll_runs[]          @relation("payroll_runs_school_id_approved_by_user_idTousers")
  payroll_runs_payroll_runs_school_id_generated_by_user_id payroll_runs[]          @relation("payroll_runs_school_id_generated_by_user_idTousers")
  salary_payments                                          salary_payments[]
  user_roles                                               user_roles[]

  @@unique([school_id, email])
  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Students master table per school
model students {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id            String                 @db.Uuid
  campus_id            String?                @db.Uuid
  admission_no         String                 @db.VarChar(60)
  first_name           String                 @db.VarChar(100)
  last_name            String?                @db.VarChar(100)
  date_of_birth        DateTime?              @db.Date
  gender               String?                @db.VarChar(20)
  photo_file_id        String?                @db.Uuid
  status               String                 @default("active") @db.VarChar(20)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  schools              schools                @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campuses             campuses?              @relation(fields: [school_id, campus_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  photo_file           file_assets?           @relation("student_photo_file", fields: [school_id, photo_file_id], references: [school_id, id], onDelete: SetNull, onUpdate: NoAction)
  admissions           admissions[]
  exam_results         exam_results[]
  fee_discounts        fee_discounts[]
  fee_payments         fee_payments[]
  homework_submissions homework_submissions[]
  issued_certificates  issued_certificates[]
  library_members      library_members[]
  student_attendance   student_attendance[]
  student_documents    student_documents[]
  student_enrollments  student_enrollments[]
  student_guardians    student_guardians[]
  student_invoices     student_invoices[]

  @@unique([school_id, admission_no])
  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Staff / Teachers master table per school
model staff {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String             @db.Uuid
  campus_id        String?            @db.Uuid
  staff_code       String             @db.VarChar(60)
  first_name       String             @db.VarChar(100)
  last_name        String?            @db.VarChar(100)
  designation      String?            @db.VarChar(100)
  photo_file_id    String?            @db.Uuid
  status           String             @default("active") @db.VarChar(20)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  schools          schools            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campuses         campuses?          @relation(fields: [school_id, campus_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  photo_file       file_assets?       @relation("staff_photo_file", fields: [school_id, photo_file_id], references: [school_id, id], onDelete: SetNull, onUpdate: NoAction)
  class_subjects   class_subjects[]
  exam_results     exam_results[]
  homework         homework[]
  library_members  library_members[]
  payroll_items    payroll_items[]
  staff_attendance staff_attendance[]

  @@unique([school_id, id])
  @@unique([school_id, staff_code])
  @@schema("school_erp")
}

/// Documents aur images ki category (jaise student_doc, camera_photo, homework_file)
model file_categories {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id   String        @db.Uuid
  code        String        @db.VarChar(60)
  name        String        @db.VarChar(120)
  description String?
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  schools     schools       @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file_assets file_assets[]

  @@unique([school_id, code])
  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Uploaded documents aur captured/uploaded images ka central storage table
model file_assets {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id                     String                          @db.Uuid
  category_id                   String?                         @db.Uuid
  uploaded_by_user_id           String?                         @db.Uuid
  file_name                     String                          @db.VarChar(255)
  mime_type                     String                          @db.VarChar(120)
  file_size                     Int
  file_data                     Bytes
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  schools                       schools                         @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file_categories               file_categories?                @relation(fields: [school_id, category_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  uploaded_by                   users?                          @relation("file_uploader", fields: [school_id, uploaded_by_user_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  school_logos                  schools[]                       @relation("school_logo_file")
  user_avatars                  users[]                         @relation("user_avatar_file")
  student_photos                students[]                      @relation("student_photo_file")
  staff_photos                  staff[]                         @relation("staff_photo_file")
  student_documents             student_documents[]
  admission_documents           admission_documents[]
  homework_documents            homework_documents[]
  homework_submission_documents homework_submission_documents[]
  guardian_documents            guardian_documents[]
  certificate_templates         certificate_templates[]

  @@unique([school_id, id])
  @@schema("school_erp")
}

/// Student ke documents (certificates, ID proofs, transfer records, etc.)
model student_documents {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id     String      @db.Uuid
  student_id    String      @db.Uuid
  file_asset_id String      @db.Uuid
  doc_type      String?     @db.VarChar(80)
  title         String?     @db.VarChar(180)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  schools       schools     @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students      students    @relation(fields: [school_id, student_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)
  file_assets   file_assets @relation(fields: [school_id, file_asset_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, id])
  @@schema("school_erp")
}

