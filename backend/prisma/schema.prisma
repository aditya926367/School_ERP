generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["school_erp"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model academic_years {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id           String                @unique(map: "one_current_academic_year_per_school", where: raw("is_current")) @db.Uuid
  name                String                @db.VarChar(40)
  start_date          DateTime              @db.Date
  end_date            DateTime              @db.Date
  is_current          Boolean               @default(false)
  status              String                @default("planned") @db.VarChar(20)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  schools             schools               @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admissions          admissions[]
  class_subjects      class_subjects[]
  exams               exams[]
  fee_structures      fee_structures[]
  homework            homework[]
  student_attendance  student_attendance[]
  student_enrollments student_enrollments[]
  student_invoices    student_invoices[]
  timetable_entries   timetable_entries[]

  @@unique([school_id, id])
  @@unique([school_id, name])
  @@schema("school_erp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model admissions {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id          String          @db.Uuid
  application_no     String          @db.VarChar(60)
  academic_year_id   String?         @db.Uuid
  applicant_name     String          @db.VarChar(200)
  date_of_birth      DateTime?       @db.Date
  applying_for_class String?         @db.VarChar(80)
  parent_name        String?         @db.VarChar(180)
  parent_phone       String?         @db.VarChar(30)
  parent_email       String?         @db.VarChar(254)
  application_date   DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  status             String          @default("submitted") @db.VarChar(30)
  remarks            String?
  student_id         String?         @db.Uuid
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  academic_years     academic_years? @relation(fields: [school_id, academic_year_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  schools            schools         @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students           students?       @relation(fields: [school_id, student_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([school_id, application_no])
  @@unique([school_id, id])
  @@schema("school_erp")
}

model campuses {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id   String     @db.Uuid
  campus_code String     @db.VarChar(40)
  name        String     @db.VarChar(160)
  address     String?
  phone       String?    @db.VarChar(30)
  is_main     Boolean    @default(false)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  schools     schools    @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  classes     classes[]
  staff       staff[]
  students    students[]
  users       users[]

  @@unique([school_id, campus_code])
  @@unique([school_id, id])
  @@schema("school_erp")
}

model class_subjects {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String         @db.Uuid
  class_id         String         @db.Uuid
  subject_id       String         @db.Uuid
  teacher_staff_id String?        @db.Uuid
  academic_year_id String         @db.Uuid
  academic_years   academic_years @relation(fields: [school_id, academic_year_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  classes          classes        @relation(fields: [school_id, class_id], references: [school_id, id], onDelete: Cascade, onUpdate: NoAction)
  schools          schools        @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects         subjects       @relation(fields: [school_id, subject_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)
  staff            staff?         @relation(fields: [school_id, teacher_staff_id], references: [school_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([school_id, class_id, subject_id, academic_year_id])
  @@unique([school_id, id])
  @@schema("school_erp")
}

